<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.webjars.npm:tom-select</id>
    <version>2.6.2</version>
    <type>jar</type>
    <name>tom-select</name>
    <summary>WebJar for tom-select</summary>
    <website>https://www.webjars.org</website>
    <authors>
        <author>
            <name>webjars</name>
            <url>https://www.webjars.org</url>
        </author>
    </authors>
    <licenses>
        <license>
            <name>Apache-2.0</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/orchidjs/tom-select</url>
        <connection>
            <system>https</system>
            <path>//github.com/orchidjs/tom-select.git</path>
        </connection>
        <developerconnection>
            <system>https</system>
            <path>//github.com/orchidjs/tom-select.git</path>
        </developerconnection>
        <tag>https://github.com/orchidjs/tom-select</tag>
    </scm>
    <issuemanagement>
        <url>https://github.com/orchidjs/tom-select/issues</url>
    </issuemanagement>
    <dependencies>
        <dependency>
            <id>org.webjars.npm:orchidjs__sifter</id>
            <version>[1.1.0,2.0.0-0)</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>compile</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
        <dependency>
            <id>org.webjars.npm:orchidjs__unicode-variants</id>
            <version>[1.1.2,2.0.0-0)</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>compile</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
    </dependencies>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>org.webjars.npm</maven.groupid>
        <maven.artifactid>tom-select</maven.artifactid>
    </properties>
</extension>
