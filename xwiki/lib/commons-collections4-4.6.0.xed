            <name>Rodney Waldhoff</name>
        </author>
        <author>
            <name>Henri Yandell</name>
        </author>
        <author>
            <name>Rob Tompkins</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>Apache-2.0</name>
        </license>
    </licenses>
    <scm>
        <url>https://gitbox.apache.org/repos/asf?p=commons-collections.git</url>
        <connection>
            <system>git</system>
            <path>https://gitbox.apache.org/repos/asf/commons-collections.git</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>https://gitbox.apache.org/repos/asf/commons-collections.git</path>
        </developerconnection>
        <tag>https://gitbox.apache.org/repos/asf?p=commons-collections.git</tag>
    </scm>
    <issuemanagement>
        <system>JIRA</system>
        <url>https://issues.apache.org/jira/browse/COLLECTIONS</url>
    </issuemanagement>
