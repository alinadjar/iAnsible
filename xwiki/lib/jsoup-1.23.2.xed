                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>org.jsoup</maven.groupid>
        <maven.artifactid>jsoup</maven.artifactid>
    </properties>
</extension>
