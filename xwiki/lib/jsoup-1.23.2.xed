<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.jsoup:jsoup</id>
    <version>1.23.2</version>
    <type>jar</type>
    <name>jsoup Java HTML Parser</name>
    <summary>jsoup is a Java library that simplifies working with real-world HTML and XML. It offers an easy-to-use API for URL fetching, data parsing, extraction, and manipulation using DOM API methods, CSS, and xpath selectors. jsoup implements the WHATWG HTML5 specification, and parses HTML to the same DOM as modern browsers.</summary>
    <website>https://jsoup.org/</website>
    <authors>
        <author>
            <name>Jonathan Hedley</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>The MIT License</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/jhy/jsoup</url>
        <connection>
            <system>git</system>
            <path>https://github.com/jhy/jsoup.git</path>
        </connection>
        <tag>https://github.com/jhy/jsoup</tag>
    </scm>
    <issuemanagement>
        <system>GitHub</system>
        <url>https://github.com/jhy/jsoup/issues</url>
    </issuemanagement>
