<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>io.sf.carte:tokenproducer</id>
    <version>3.3</version>
    <type>jar</type>
    <summary>Low-level parsing library</summary>
    <website>https://github.com/css4j/tokenproducer</website>
    <licenses>
        <license>
            <name>BSD 3-clause license</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/css4j/tokenproducer</url>
        <connection>
            <system>git</system>
            <path>https://github.com/css4j/tokenproducer.git</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>git://git@github.com:css4j/tokenproducer.git</path>
        </developerconnection>
        <tag>https://github.com/css4j/tokenproducer</tag>
    </scm>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>io.sf.carte</maven.groupid>
        <maven.artifactid>tokenproducer</maven.artifactid>
    </properties>
</extension>
