    <dependencies>
        <dependency>
            <id>org.apache.solr:solr-core</id>
            <version>9.4.1</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>compile</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
            <exclusions>
                <extensionpattern>
                    <id>log4j:log4j</id>
                </extensionpattern>
                <extensionpattern>
                    <id>\Qch.qos.logback\E:.*</id>
                </extensionpattern>
                <extensionpattern>
                    <id>commons-logging:commons-logging</id>
                </extensionpattern>
                <extensionpattern>
                    <id>com.google.code.findbugs:jsr305</id>
