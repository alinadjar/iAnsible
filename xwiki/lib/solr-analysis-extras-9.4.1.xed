    <scm>
        <url>https://gitbox.apache.org/repos/asf?p=solr.git</url>
        <connection>
            <system>git</system>
            <path>https://gitbox.apache.org/repos/asf/solr.git</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>https://gitbox.apache.org/repos/asf/solr.git</path>
        </developerconnection>
        <tag>https://gitbox.apache.org/repos/asf?p=solr.git</tag>
