<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.quartz-scheduler:quartz</id>
    <version>2.5.2</version>
    <type>jar</type>
    <name>quartz</name>
    <summary>Quartz Enterprise Job Scheduler</summary>
    <website>https://www.quartz-scheduler.org/</website>
    <authors>
        <author>
            <name>Terracotta Engineers</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/quartz-scheduler/quartz</url>
        <connection>
            <system>git</system>
            <path>git://github.com:quartz-scheduler/quartz.git</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>ssh:git@github.com:quartz-scheduler/quartz.git</path>
        </developerconnection>
        <tag>https://github.com/quartz-scheduler/quartz</tag>
    </scm>
    <dependencies>
        <dependency>
            <id>org.slf4j:slf4j-api</id>
            <version>2.0.16</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>runtime</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
        <dependency>
            <id>jakarta.xml.bind:jakarta.xml.bind-api</id>
            <version>4.0.4</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>runtime</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
    </dependencies>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>org.quartz-scheduler</maven.groupid>
        <maven.artifactid>quartz</maven.artifactid>
    </properties>
</extension>
