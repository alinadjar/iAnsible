<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>xmlpull:xmlpull</id>
    <version>1.1.3.1</version>
    <type>jar</type>
    <name>XML Pull Parsing API</name>
    <website>http://www.xmlpull.org</website>
    <licenses>
        <license>
            <name>Public Domain</name>
        </license>
    </licenses>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>xmlpull</maven.groupid>
        <maven.artifactid>xmlpull</maven.artifactid>
    </properties>
</extension>
