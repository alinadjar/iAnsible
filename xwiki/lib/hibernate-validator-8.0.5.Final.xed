<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.hibernate.validator:hibernate-validator</id>
    <version>8.0.5.Final</version>
    <type>jar</type>
    <name>Hibernate Validator Engine</name>
    <summary>Hibernate's Jakarta Bean Validation reference implementation.</summary>
    <website>https://hibernate.org/validator</website>
    <extensionfeatures>
        <feature>
            <feature>org.hibernate:hibernate-validator</feature>
            <version>8.0.5.Final</version>
        </feature>
    </extensionfeatures>
    <features>
        <feature>org.hibernate:hibernate-validator</feature>
    </features>
    <authors>
        <author>
            <name>Emmanuel Bernard</name>
            <url>https://in.relation.to/emmanuel-bernard/</url>
        </author>
        <author>
            <name>Hardy Ferentschik</name>
            <url>https://in.relation.to/hardy-ferentschik/</url>
        </author>
        <author>
            <name>Gunnar Morling</name>
            <url>https://in.relation.to/gunnar-morling/</url>
        </author>
        <author>
            <name>Kevin Pollet</name>
            <url>https://www.serli.com/</url>
        </author>
        <author>
            <name>Davide D'Alto</name>
            <url>https://in.relation.to/davide-dalto/</url>
        </author>
        <author>
            <name>Guillaume Smet</name>
            <url>https://in.relation.to/guillaume-smet/</url>
        </author>
        <author>
            <name>Marko Bekhta</name>
            <url>https//in.relation.to/marko-bekhta/</url>
        </author>
    </authors>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/hibernate/hibernate-validator</url>
        <connection>
            <system>git</system>
            <path>git://github.com/hibernate/hibernate-validator.git</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>git@github.com:hibernate/hibernate-validator.git</path>
        </developerconnection>
        <tag>https://github.com/hibernate/hibernate-validator</tag>
    </scm>
    <dependencies>
        <dependency>
            <id>jakarta.validation:jakarta.validation-api</id>
            <version>3.0.2</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>compile</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
        <dependency>
            <id>org.jboss.logging:jboss-logging</id>
            <version>3.4.3.Final</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>compile</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
        <dependency>
            <id>com.fasterxml:classmate</id>
            <version>1.5.1</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>compile</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
    </dependencies>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>org.hibernate.validator</maven.groupid>
        <maven.artifactid>hibernate-validator</maven.artifactid>
    </properties>
</extension>
