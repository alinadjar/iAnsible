<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>com.sun.activation:javax.activation</id>
    <version>1.2.0</version>
    <type>jar</type>
    <name>JavaBeans Activation Framework</name>
    <summary>JavaBeans Activation Framework</summary>
    <website>http://java.net/all/javax.activation/</website>
    <extensionfeatures>
        <feature>
            <feature>javax.activation:activation</feature>
            <version>1.2.0</version>
        </feature>
    </extensionfeatures>
    <features>
        <feature>javax.activation:activation</feature>
    </features>
    <authors>
        <author>
            <name>Bill Shannon</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>CDDL/GPLv2+CE</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/javaee/activation/javax.activation</url>
        <connection>
            <system>git</system>
            <path>https://github.com/javaee/activation.git/javax.activation</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>git@github.com:javaee/activation.git/javax.activation</path>
        </developerconnection>
        <tag>https://github.com/javaee/activation/javax.activation</tag>
    </scm>
    <issuemanagement>
        <system>GitHub</system>
        <url>https://github.com/javaee/activation/issues</url>
    </issuemanagement>
    <manageddependencies>
        <dependency>
            <id>com.sun.activation:javax.activation</id>
            <version>1.2.0</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
    </manageddependencies>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>jvnet-nexus-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>com.sun.activation</maven.groupid>
        <maven.artifactid>javax.activation</maven.artifactid>
    </properties>
</extension>
