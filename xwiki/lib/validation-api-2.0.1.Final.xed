<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>javax.validation:validation-api</id>
    <version>2.0.1.Final</version>
    <type>jar</type>
    <name>Bean Validation API</name>
    <summary>Bean Validation API</summary>
    <website>http://beanvalidation.org</website>
    <authors>
        <author>
            <name>Emmanuel Bernard</name>
            <url>http://in.relation.to/emmanuel-bernard/</url>
        </author>
        <author>
            <name>Emmanuel Bernard</name>
            <url>http://in.relation.to/emmanuel-bernard/</url>
        </author>
        <author>
            <name>Hardy Ferentschik</name>
            <url>http://in.relation.to/hardy-ferentschik/</url>
        </author>
        <author>
            <name>Gunnar Morling</name>
            <url>http://in.relation.to/gunnar-morling/</url>
        </author>
        <author>
            <name>Guillaume Smet</name>
            <url>http://in.relation.to/guillaume-smet/</url>
        </author>
    </authors>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/beanvalidation/beanvalidation-api</url>
        <connection>
            <system>git</system>
            <path>git://github.com/beanvalidation/beanvalidation-api.git</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>git@github.com:beanvalidation/beanvalidation-api.git</path>
        </developerconnection>
        <tag>https://github.com/beanvalidation/beanvalidation-api</tag>
    </scm>
    <issuemanagement>
        <system>JIRA</system>
        <url>https://hibernate.atlassian.net/projects/BVAL/</url>
    </issuemanagement>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>javax.validation</maven.groupid>
        <maven.artifactid>validation-api</maven.artifactid>
    </properties>
</extension>
