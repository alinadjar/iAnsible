<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.apache.logging.log4j:log4j-api</id>
    <version>2.26.1</version>
    <type>jar</type>
    <name>Apache Log4j API</name>
    <summary>The logging API of the Log4j project.
    Library and application code can log through this API.
    It contains a simple built-in implementation (`SimpleLogger`) for trivial use cases.
    Production applications are recommended to use Log4j API in combination with a fully-fledged implementation, such as Log4j Core.</summary>
    <website>https://logging.apache.org/log4j/2.x/</website>
    <authors>
        <author>
            <name>Ralph Goers</name>
        </author>
        <author>
            <name>Gary Gregory</name>
            <url>https://www.garygregory.com</url>
        </author>
        <author>
            <name>Scott Deboy</name>
        </author>
        <author>
            <name>Remko Popma</name>
        </author>
        <author>
            <name>Nick Williams</name>
        </author>
        <author>
            <name>Matt Sicker</name>
        </author>
        <author>
            <name>Bruce Brouwer</name>
        </author>
        <author>
            <name>Raman Gupta</name>
        </author>
        <author>
            <name>Mikael Ståldal</name>
        </author>
        <author>
            <name>Carter Kozak</name>
            <url>https://github.com/carterkozak</url>
        </author>
        <author>
            <name>Volkan Yazıcı</name>
        </author>
        <author>
            <name>Ron Grabowski</name>
        </author>
        <author>
            <name>Piotr P. Karwasz</name>
        </author>
        <author>
            <name>Christian Grobmeier</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>Apache-2.0</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/apache/logging-log4j2</url>
        <connection>
            <system>git</system>
            <path>https://github.com/apache/logging-log4j2.git</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>https://github.com/apache/logging-log4j2.git</path>
        </developerconnection>
        <tag>https://github.com/apache/logging-log4j2</tag>
    </scm>
    <issuemanagement>
        <system>GitHub Issues</system>
        <url>https://github.com/apache/logging-log4j2/issues</url>
    </issuemanagement>
