                    <id>com.google.code.findbugs:jsr305</id>
                </extensionpattern>
                <extensionpattern>
                    <id>com.google.code.findbugs:annotations</id>
                </extensionpattern>
                <extensionpattern>
                    <id>javax.annotation:javax.annotation-api</id>
                </extensionpattern>
                <extensionpattern>
                    <id>org.slf4j:slf4j-log4j12</id>
                </extensionpattern>
                <extensionpattern>
                    <id>org.apache.yetus:audience-annotations</id>
                </extensionpattern>
                <extensionpattern>
                    <id>org.codehaus.mojo:animal-sniffer-annotations</id>
                </extensionpattern>
                <extensionpattern>
                    <id>net.jcip:jcip-annotations</id>
                </extensionpattern>
            </exclusions>
        </dependency>
    </dependencies>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>org.apache.solr</maven.groupid>
        <maven.artifactid>solr-core</maven.artifactid>
    </properties>
</extension>
