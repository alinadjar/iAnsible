<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>javax.inject:javax.inject</id>
    <version>1</version>
    <type>jar</type>
    <name>javax.inject</name>
    <summary>The javax.inject API</summary>
    <website>http://code.google.com/p/atinject/</website>
    <extensionfeatures>
        <feature>
            <feature>org.glassfish.hk2.external:jakarta.inject</feature>
            <version>1</version>
        </feature>
    </extensionfeatures>
    <features>
        <feature>org.glassfish.hk2.external:jakarta.inject</feature>
    </features>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
        </license>
    </licenses>
    <scm>
        <url>http://code.google.com/p/atinject/source/checkout</url>
        <tag>http://code.google.com/p/atinject/source/checkout</tag>
    </scm>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>javax.inject</maven.groupid>
        <maven.artifactid>javax.inject</maven.artifactid>
    </properties>
</extension>
