<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>javax.transaction:javax.transaction-api</id>
    <version>1.3</version>
    <type>jar</type>
    <name>javax.transaction API</name>
    <summary>Project GlassFish Java Transaction API</summary>
    <website>http://jta-spec.java.net</website>
    <extensionfeatures>
        <feature>
            <feature>javax.transaction:jta</feature>
            <version>1.3</version>
        </feature>
        <feature>
            <feature>org.jboss.spec.javax.transaction:jboss-transaction-api_1.2_spec</feature>
            <version>1.3</version>
        </feature>
    </extensionfeatures>
    <features>
        <feature>javax.transaction:jta</feature>
        <feature>org.jboss.spec.javax.transaction:jboss-transaction-api_1.2_spec</feature>
    </features>
    <authors>
        <author>
            <name>Stephen Felts</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>CDDL + GPLv2 with classpath exception</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/javaee/javax.transaction</url>
        <connection>
            <system>git</system>
            <path>https://github.com/javaee/javax.transaction.git</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>git@github.com:javaee/javax.transaction.git</path>
        </developerconnection>
        <tag>https://github.com/javaee/javax.transaction</tag>
    </scm>
    <issuemanagement>
        <system>jira</system>
        <url>https://github.com/javaee/javax.transaction/issues</url>
    </issuemanagement>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>jvnet-nexus-releases</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>javax.transaction</maven.groupid>
        <maven.artifactid>javax.transaction-api</maven.artifactid>
    </properties>
</extension>
