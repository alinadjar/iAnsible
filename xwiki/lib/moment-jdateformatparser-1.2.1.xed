<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.webjars.npm:moment-jdateformatparser</id>
    <version>1.2.1</version>
    <type>jar</type>
    <name>moment-jdateformatparser</name>
    <summary>WebJar for moment-jdateformatparser</summary>
    <website>http://webjars.org</website>
    <extensionfeatures>
        <feature>
            <feature>org.webjars:moment-jdateformatparser</feature>
            <version>1.2.1</version>
        </feature>
    </extensionfeatures>
    <features>
        <feature>org.webjars:moment-jdateformatparser</feature>
    </features>
    <authors>
        <author>
            <name>webjars</name>
            <url>http://webjars.org</url>
        </author>
    </authors>
    <licenses>
        <license>
            <name>The MIT License</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/MadMG/moment-jdateformatparser</url>
        <connection>
            <system>https</system>
            <path>//github.com/MadMG/moment-jdateformatparser.git</path>
        </connection>
        <developerconnection>
            <system>https</system>
            <path>//github.com/MadMG/moment-jdateformatparser.git</path>
        </developerconnection>
        <tag>https://github.com/MadMG/moment-jdateformatparser</tag>
    </scm>
    <issuemanagement>
        <url>https://github.com/MadMG/moment-jdateformatparser/issues</url>
    </issuemanagement>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>org.webjars.npm</maven.groupid>
        <maven.artifactid>moment-jdateformatparser</maven.artifactid>
    </properties>
</extension>
