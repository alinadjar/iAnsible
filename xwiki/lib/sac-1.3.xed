<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.w3c.css:sac</id>
    <version>1.3</version>
    <type>jar</type>
    <name>Simple API for CSS</name>
    <summary>SAC is a standard interface for CSS parsers.</summary>
    <website>http://www.w3.org/Style/CSS/SAC/</website>
    <licenses>
        <license>
            <name>W3C Software Notice and License</name>
        </license>
    </licenses>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>org.w3c.css</maven.groupid>
        <maven.artifactid>sac</maven.artifactid>
    </properties>
</extension>
