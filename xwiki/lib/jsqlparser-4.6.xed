<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>com.github.jsqlparser:jsqlparser</id>
    <version>4.6</version>
    <type>jar</type>
    <name>JSQLParser library</name>
    <summary>JSqlParser parses an SQL statement and translate it into a hierarchy of Java classes.
        The generated hierarchy can be navigated using the Visitor Pattern.</summary>
    <website>https://github.com/JSQLParser/JSqlParser</website>
    <authors>
        <author>
            <name>Tobias Warneke</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
        </license>
        <license>
            <name>Apache License 2.0</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/JSQLParser/JSqlParser.git</url>
        <connection>
            <system>git</system>
            <path>https://github.com/JSQLParser/JSqlParser.git</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>ssh://git@github.com:JSQLParser/JSqlParser.git</path>
        </developerconnection>
        <tag>https://github.com/JSQLParser/JSqlParser.git</tag>
    </scm>
    <issuemanagement>
        <system>GitHub Issues</system>
        <url>https://github.com/JSQLParser/JSqlParser/issues</url>
    </issuemanagement>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>com.github.jsqlparser</maven.groupid>
        <maven.artifactid>jsqlparser</maven.artifactid>
    </properties>
</extension>
