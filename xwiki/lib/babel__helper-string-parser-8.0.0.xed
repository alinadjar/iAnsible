<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.webjars.npm:babel__helper-string-parser</id>
    <version>8.0.0</version>
    <type>jar</type>
    <name>@babel/helper-string-parser</name>
    <summary>WebJar for @babel/helper-string-parser</summary>
    <website>https://www.webjars.org</website>
    <authors>
        <author>
            <name>webjars</name>
            <url>https://www.webjars.org</url>
        </author>
    </authors>
    <licenses>
        <license>
            <name>The MIT License</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/babel/babel</url>
        <connection>
            <system>https</system>
            <path>//github.com/babel/babel.git</path>
        </connection>
        <developerconnection>
            <system>https</system>
            <path>//github.com/babel/babel.git</path>
        </developerconnection>
        <tag>https://github.com/babel/babel</tag>
    </scm>
    <issuemanagement>
        <url>https://github.com/babel/babel/issues</url>
    </issuemanagement>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>org.webjars.npm</maven.groupid>
        <maven.artifactid>babel__helper-string-parser</maven.artifactid>
    </properties>
</extension>
