<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>io.netty:netty-resolver</id>
    <version>4.2.18.Final</version>
    <type>jar</type>
    <name>Netty/Resolver</name>
    <summary>Netty is an asynchronous event-driven network application framework for
    rapid development of maintainable high performance protocol servers and
    clients.</summary>
    <website>https://netty.io/netty-resolver/</website>
    <authors>
        <author>
            <name>The Netty Project Contributors</name>
            <url>https://netty.io/</url>
        </author>
    </authors>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/netty/netty/netty-resolver</url>
        <connection>
            <system>git</system>
            <path>git://github.com/netty/netty.git/netty-resolver</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>ssh://git@github.com/netty/netty.git/netty-resolver</path>
        </developerconnection>
        <tag>https://github.com/netty/netty/netty-resolver</tag>
    </scm>
