<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.webjars.npm:vue-i18n</id>
    <version>11.4.4</version>
    <type>jar</type>
    <name>vue-i18n</name>
    <summary>WebJar for vue-i18n</summary>
    <website>https://www.webjars.org</website>
    <authors>
        <author>
            <name>webjars</name>
            <url>https://www.webjars.org</url>
        </author>
    </authors>
    <licenses>
        <license>
            <name>The MIT License</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/intlify/vue-i18n</url>
        <connection>
            <system>https</system>
            <path>//github.com/intlify/vue-i18n.git</path>
        </connection>
        <developerconnection>
            <system>https</system>
            <path>//github.com/intlify/vue-i18n.git</path>
        </developerconnection>
        <tag>https://github.com/intlify/vue-i18n</tag>
    </scm>
    <issuemanagement>
        <url>https://github.com/intlify/vue-i18n/issues</url>
    </issuemanagement>
    <dependencies>
        <dependency>
            <id>org.webjars.npm:vue__devtools-api</id>
            <version>[6.5.0,7.0.0-0)</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>compile</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
        <dependency>
            <id>org.webjars.npm:intlify__core-base</id>
            <version>11.4.4</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>compile</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
        <dependency>
            <id>org.webjars.npm:intlify__devtools-types</id>
            <version>11.4.4</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>compile</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
        <dependency>
            <id>org.webjars.npm:intlify__shared</id>
            <version>11.4.4</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>compile</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
    </dependencies>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>org.webjars.npm</maven.groupid>
        <maven.artifactid>vue-i18n</maven.artifactid>
    </properties>
</extension>
