<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.jboss.threads:jboss-threads</id>
    <version>3.6.1.Final</version>
    <type>jar</type>
    <name>JBoss Threads</name>
    <summary>Provides, via submodules, a base configuration for JBoss project builds, as well as a derived configuration supporting multi-release JARs</summary>
    <website>http://www.jboss.org</website>
    <authors>
        <author>
            <name>JBoss.org Community</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/jbossas/jboss-threads</url>
        <connection>
            <system>git</system>
            <path>git@github.com:jbossas/jboss-threads.git</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>git@github.com:jbossas/jboss-threads.git</path>
        </developerconnection>
        <tag>https://github.com/jbossas/jboss-threads</tag>
    </scm>
    <issuemanagement>
        <system>Jira</system>
        <url>https://issues.jboss.org/browse/JBTHR</url>
    </issuemanagement>
    <dependencies>
        <dependency>
            <id>org.jboss.logging:jboss-logging</id>
            <version>3.5.3.Final</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>compile</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
        <dependency>
            <id>org.wildfly.common:wildfly-common</id>
            <version>1.7.0.Final</version>
            <optional type="boolean">false</optional>
            <properties>
                <maven.dependency.scope>compile</maven.dependency.scope>
                <maven.dependency.type>jar</maven.dependency.type>
            </properties>
        </dependency>
    </dependencies>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>org.jboss.threads</maven.groupid>
        <maven.artifactid>jboss-threads</maven.artifactid>
    </properties>
</extension>
