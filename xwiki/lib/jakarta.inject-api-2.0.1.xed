<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>jakarta.inject:jakarta.inject-api</id>
    <version>2.0.1</version>
    <type>jar</type>
    <name>Jakarta Dependency Injection</name>
    <summary>Jakarta Dependency Injection</summary>
    <website>https://github.com/eclipse-ee4j/injection-api</website>
    <authors>
        <author>
            <name>Antoine Sabot-Durand</name>
        </author>
        <author>
            <name>Martin Kouba</name>
        </author>
        <author>
            <name>Tomas Remes</name>
        </author>
        <author>
            <name>Matej Novotny</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/eclipse-ee4j/injection-api</url>
        <connection>
            <system>git</system>
            <path>ssh://git@github.com/eclipse-ee4j/injection-api.git</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>ssh://git@github.com/eclipse-ee4j/injection-api.git</path>
        </developerconnection>
        <tag>https://github.com/eclipse-ee4j/injection-api</tag>
    </scm>
    <issuemanagement>
        <system>GitHub Issues</system>
        <url>https://github.com/eclipse-ee4j/ee4j/issues</url>
    </issuemanagement>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>jakarta.inject</maven.groupid>
        <maven.artifactid>jakarta.inject-api</maven.artifactid>
    </properties>
</extension>
