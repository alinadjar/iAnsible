<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>oro:oro</id>
    <version>2.0.8</version>
    <type>jar</type>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>oro</maven.groupid>
        <maven.artifactid>oro</maven.artifactid>
    </properties>
</extension>
