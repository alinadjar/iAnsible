<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.springframework.security:spring-security-crypto</id>
    <version>7.1.1</version>
    <type>jar</type>
    <name>spring-security-crypto</name>
    <summary>Spring Security</summary>
    <website>https://spring.io/projects/spring-security</website>
    <authors>
        <author>
            <name>Pivotal</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/spring-projects/spring-security</url>
        <connection>
            <system>git</system>
            <path>git://github.com/spring-projects/spring-security.git</path>
        </connection>
        <developerconnection>
            <system>git</system>
            <path>ssh://git@github.com/spring-projects/spring-security.git</path>
        </developerconnection>
        <tag>https://github.com/spring-projects/spring-security</tag>
    </scm>
    <issuemanagement>
        <system>GitHub</system>
        <url>https://github.com/spring-projects/spring-security/issues</url>
    </issuemanagement>
    <repositories>
        <repository>
            <id>xwiki-snapshots</id>
            <type>maven</type>
            <properties>
                <maven.release>false</maven.release>
                <maven.snapshot>true</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public-proxy</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
        <repository>
            <id>xwiki-public</id>
            <type>maven</type>
            <properties>
                <maven.release>true</maven.release>
                <maven.snapshot>false</maven.snapshot>
            </properties>
        </repository>
    </repositories>
    <properties>
        <maven.groupid>org.springframework.security</maven.groupid>
        <maven.artifactid>spring-security-crypto</maven.artifactid>
    </properties>
</extension>
