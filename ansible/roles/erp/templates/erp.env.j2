{% set hv = hostvars[inventory_hostname] %}
{% set ip = hv.get('erp_node_ip') | default(hv.get('ansible_host'), true) %}
{% set scheme = erp_public_url_scheme | default('https') %}
{% set api_url = erp_self_url | default('') | trim %}
{% set app_url = erp_app_url | default('') | trim %}
{% if api_url | length == 0 and (erp_use_platform_integration_urls | default(false) | bool) %}
{% set pi = platform_integration | default({}) %}
{% set api_url = pi.erp_public_api_url | default('') %}
{% set app_url = pi.erp_public_app_url | default('') %}
{% endif %}
{% if api_url | length == 0 %}
{% set api_url = scheme ~ '://' ~ ip ~ ':' ~ erp_nginx_port_back %}
{% endif %}
{% if app_url | length == 0 %}
{% set app_url = scheme ~ '://' ~ ip ~ ':' ~ erp_nginx_port_front %}
{% endif %}
{% set cors = erp_cors_origins | default(app_url ~ ',' ~ api_url) %}
{% set deploy_path = erp_sidecar_deploy_path | default(erp_deploy_path) %}
ERP={{ erp_project_code | default('fx') }}
REGISTRY_URL={{ erp_registry_url }}
LicenseServer={{ erp_license_server | default('https://api-license-alpha.sadgan.com') }}

SelfUrl={{ api_url }}
CorsOrigins={{ cors }}

ERP_VERSION={{ erp_version }}
PG_VERSION={{ erp_pg_version | default('18.0') }}
REDIS_VERSION={{ erp_redis_version | default('7.2') }}
NGINX_VERSION={{ erp_nginx_version | default('1.28.0') }}
SIDECAR_VERSION={{ erp_sidecar_version | default('v1.4.7') }}

REGISTRY_USER={{ erp_registry_user }}
REGISTRY_PASSWORD={{ vault_erp_registry_password }}
REGISTRY_TLS_SKIP_VERIFY={{ erp_registry_tls_skip_verify | default('true') }}

REDIS_PASSWORD={{ vault_erp_redis_password }}
POSTGRES_USER={{ erp_postgres_user | default('postgres') }}
POSTGRES_DB={{ vault_erp_postgres_db | default('postgres') }}
PG_RW_HOST={{ erp_pg_rw_host | default('pg') }}
PG_RW_USER={{ erp_pg_rw_user | default('postgres') }}
POSTGRES_PASSWORD={{ vault_erp_postgres_password }}
PG_MaxPoolSize={{ erp_pg_max_pool_size | default(500) }}
PG_RO_HOST={{ erp_pg_ro_host | default('pg') }}
PG_RO_PORT={{ erp_pg_ro_port | default(5432) }}
PG_RO_USER={{ erp_pg_ro_user | default('readonly_user') }}
POSTGRES_RO_PASSWORD={{ vault_erp_postgres_ro_password }}
PG_MaxPoolSize_RO={{ erp_pg_max_pool_size_ro | default(500) }}
REPLICA_IP_LB={{ erp_replica_ip_lb | default(ip) }}
REPLICA_PORT_LB={{ erp_replica_port_lb | default(5401) }}
PG_REPLICA_USER={{ erp_pg_replica_user | default('replica_user') }}
PG_REPLICA_PASSWORD={{ vault_erp_pg_replica_password | default(vault_erp_postgres_password) }}
PG_MaxPoolSize_REPLICA={{ erp_pg_max_pool_size_replica | default(500) }}
PG_BI_USER={{ vault_erp_pg_bi_user | default('ro') }}
POSTGRES_BI_PASSWORD={{ vault_erp_postgres_bi_password }}

NODE_IP={{ ip }}
INSTANCE_ID={{ erp_lock_instance_id | default(erp_instance_id | default('ERP01')) }}
DASH_PORT={{ erp_dash_port | default(3001) }}
DEPLOY_PATH={{ deploy_path }}

AGENT_PORT_FINGERPRINT={{ erp_agent_port_fingerprint | default(4000) }}
NGINX_PORT_FRONT={{ erp_nginx_port_front }}
NGINX_PORT_BACK={{ erp_nginx_port_back }}

BACKUP_PASSWORD={{ vault_erp_backup_password }}
COMPRESS_METHOD={{ erp_compress_method | default('zip') }}
SECURITY_METHOD={{ erp_security_method | default('zip') }}
PG_CONTAINER={{ erp_compose_project_name }}-pg-1
BACKUP_INSTANCE={{ erp_backup_instance | default(erp_compose_project_name) }}
RETENTION_DAYS={{ erp_backup_retention_days | default(7) }}
RETENTION_COUNT={{ erp_backup_retention_count | default(10) }}
