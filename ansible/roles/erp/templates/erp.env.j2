ERP=fx
REGISTRY_URL={{ erp_registry_url }}
LicenseServer={{ erp_license_server | default('https://api-license-alpha.sadgan.com') }}

SelfUrl={{ platform_integration.erp_public_api_url }}
CorsOrigins={{ erp_cors_origins | default(platform_integration.erp_public_app_url + ',' + platform_integration.erp_public_api_url) }}

ERP_VERSION={{ erp_version }}
PG_VERSION={{ erp_pg_version | default('18.0') }}
REDIS_VERSION={{ erp_redis_version | default('7.2') }}
NGINX_VERSION={{ erp_nginx_version | default('1.28.0') }}

REDIS_PASSWORD={{ vault_erp_redis_password }}
POSTGRES_USER={{ erp_postgres_user | default('postgres') }}
POSTGRES_DB={{ vault_erp_postgres_db }}
PG_RW_HOST={{ erp_pg_rw_host | default('pg') }}
PG_RW_USER={{ erp_pg_rw_user | default('postgres') }}
POSTGRES_PASSWORD={{ vault_erp_postgres_password }}
PG_MaxPoolSize={{ erp_pg_max_pool_size | default(500) }}
PG_RO_HOST={{ erp_pg_ro_host | default('pg') }}
PG_RO_PORT={{ erp_pg_ro_port | default(5432) }}
PG_RO_USER={{ erp_pg_ro_user | default('readonly_user') }}
POSTGRES_RO_PASSWORD={{ vault_erp_postgres_ro_password }}
PG_MaxPoolSize_RO={{ erp_pg_max_pool_size_ro | default(500) }}
REPLICA_IP_LB={{ erp_replica_ip_lb | default(hostvars[inventory_hostname]['ansible_host']) }}
REPLICA_PORT_LB={{ erp_replica_port_lb | default(5401) }}
PG_REPLICA_USER={{ erp_pg_replica_user | default('replica_user') }}
PG_REPLICA_PASSWORD={{ vault_erp_pg_replica_password | default('CHANGE_ME') }}
PG_MaxPoolSize_REPLICA={{ erp_pg_max_pool_size_replica | default(500) }}
PG_BI_USER={{ vault_erp_pg_bi_user }}
POSTGRES_BI_PASSWORD={{ vault_erp_postgres_bi_password }}

NODE_IP={{ hostvars[inventory_hostname]['ansible_host'] }}
INSTANCE_ID={{ erp_instance_id | default('ERP01') }}
DASH_PORT={{ erp_dash_port | default(3001) }}
DEPLOY_PATH={{ erp_deploy_path }}

AGENT_PORT_FINGERPRINT={{ erp_agent_port_fingerprint | default(4000) }}
NGINX_PORT_FRONT={{ erp_nginx_port_front }}
NGINX_PORT_BACK={{ erp_nginx_port_back }}

BACKUP_PASSWORD={{ vault_erp_backup_password | default('CHANGE_ME') }}
COMPRESS_METHOD={{ erp_compress_method | default('zip') }}
SECURITY_METHOD={{ erp_security_method | default('zip') }}
PG_CONTAINER={{ erp_compose_project_name }}-pg-1
