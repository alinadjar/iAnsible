# Managed by Ansible — matches erp_public_url_scheme (https => TLS listeners + certs)
{% set ssl_enabled = (erp_public_url_scheme | default('https')) == 'https' %}
{% set cert_dir = erp_nginx_ssl_cert_dir | default('/etc/nginx/certs') %}
upstream frontend {
    server front:80;
}

upstream backend_api {
    server backend:8080;
}


server {
    listen {{ erp_nginx_container_port_front | default(8001) }}{% if ssl_enabled %} ssl{% endif %};
    server_name _;

{% if ssl_enabled %}
    ssl_certificate      {{ cert_dir }}/server.crt;
    ssl_certificate_key  {{ cert_dir }}/server.key;
{% endif %}

    location = /upgrading {
        proxy_pass http://sidecar:3000/upgrading?$query_string;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /sdcr_assets/ {
        proxy_pass http://sidecar:3000/assets/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /cors {
        proxy_pass http://sidecar:3000/cors;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /curl-status {
        proxy_pass http://sidecar:3000/curl-status;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /install/report {
        proxy_pass http://sidecar:3000/install/report;
    }

    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    location / {
        if (-f /etc/nginx/maintenance/.maintenance_enabled) {
            rewrite ^ /upgrading last;
        }

        proxy_pass http://frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
    }
}


server {
    listen {{ erp_nginx_container_port_back | default(8000) }}{% if ssl_enabled %} ssl{% endif %};
    server_name _;

{% if ssl_enabled %}
    ssl_certificate      {{ cert_dir }}/server.crt;
    ssl_certificate_key  {{ cert_dir }}/server.key;
{% endif %}

    location / {
        proxy_pass http://backend_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_connect_timeout 900s;
        client_max_body_size 20M;
        client_body_timeout 600s;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
    }
}
