{# Managed by Ansible — base: monorepo dify/docker/.env (or roles/dify/files/dify.env.j2.base) #}
{% set hv = hostvars[inventory_hostname] %}
{% set ip = hv.get('dify_node_ip')
  | default((hv.get('ansible_default_ipv4') or {}).get('address'), true)
  | default(hv.get('ansible_host'), true) %}
{% set redis_pw = vault_dify_redis_password | default(vault_dify_db_password) %}
{% set env_base = dify_env_base_path | default(role_path ~ '/files/dify.env.j2.base') %}
{% set raw = lookup('file', env_base) %}
{% set use_pub_urls = dify_env_use_platform_urls | default(false) | bool %}
{% set pub = dify_console_url | default('http://' ~ ip) %}
{% set app_web = dify_app_web_url | default(pub) %}
{% set src_nginx_port = (dify_env_loopback_nginx_port | default(8080)) | string %}
{% set nginx_port = (dify_expose_nginx_port | default(8080)) | string %}
{% set host_bind = ip ~ ':' ~ nginx_port %}
{% set out = raw
  | regex_replace('127\\.0\\.0\\.1:' ~ src_nginx_port, host_bind)
  | regex_replace('http://localhost:' ~ src_nginx_port, 'http://' ~ host_bind)
  | regex_replace('ws://127\\.0\\.0\\.1:' ~ src_nginx_port, 'ws://' ~ host_bind)
  | regex_replace('wss://127\\.0\\.0\\.1:' ~ src_nginx_port, 'wss://' ~ host_bind)
  | regex_replace('ws://localhost:' ~ src_nginx_port, 'ws://' ~ host_bind)
  | regex_replace('127\\.0\\.0\\.1', ip)
  | regex_replace('http://localhost:', 'http://' ~ ip ~ ':')
  | regex_replace('http://localhost(,|$)', 'http://' ~ ip ~ '\\1')
  | regex_replace('ws://localhost', 'ws://' ~ ip)
  | regex_replace('(?m)^EXPOSE_PLUGIN_DEBUGGING_HOST=localhost\\s*$', 'EXPOSE_PLUGIN_DEBUGGING_HOST=' ~ ip)
  | regex_replace('(?m)^SECRET_KEY=.*$', 'SECRET_KEY=' ~ vault_dify_secret_key)
  | regex_replace('(?m)^DB_PASSWORD=.*$', 'DB_PASSWORD=' ~ vault_dify_db_password)
  | regex_replace('(?m)^REDIS_PASSWORD=.*$', 'REDIS_PASSWORD=' ~ redis_pw)
  | regex_replace('(?m)^CELERY_BROKER_URL=redis://:[^@]+@', 'CELERY_BROKER_URL=redis://:' ~ redis_pw ~ '@')
%}
{% if vault_dify_init_password is defined and vault_dify_init_password | length > 0 %}
{% set out = out | regex_replace('(?m)^INIT_PASSWORD=.*$', 'INIT_PASSWORD=' ~ vault_dify_init_password) %}
{% endif %}
{% if vault_dify_plugin_daemon_key is defined and vault_dify_plugin_daemon_key | length > 0 %}
{% set out = out | regex_replace('(?m)^PLUGIN_DAEMON_KEY=.*$', 'PLUGIN_DAEMON_KEY=' ~ vault_dify_plugin_daemon_key) %}
{% endif %}
{% if vault_dify_plugin_inner_api_key is defined and vault_dify_plugin_inner_api_key | length > 0 %}
{% set out = out | regex_replace('(?m)^PLUGIN_DIFY_INNER_API_KEY=.*$', 'PLUGIN_DIFY_INNER_API_KEY=' ~ vault_dify_plugin_inner_api_key) %}
{% endif %}
{% if vault_dify_agent_server_secret_key is defined and vault_dify_agent_server_secret_key | length > 0 %}
{% set out = out | regex_replace('(?m)^DIFY_AGENT_SERVER_SECRET_KEY=.*$', 'DIFY_AGENT_SERVER_SECRET_KEY=' ~ vault_dify_agent_server_secret_key) %}
{% endif %}
{% if use_pub_urls %}
{% set out = out
  | regex_replace('(?m)^CONSOLE_API_URL=.*$', 'CONSOLE_API_URL=' ~ pub ~ '/console/api')
  | regex_replace('(?m)^CONSOLE_WEB_URL=.*$', 'CONSOLE_WEB_URL=' ~ pub)
  | regex_replace('(?m)^SERVICE_API_URL=.*$', 'SERVICE_API_URL=' ~ pub ~ '/api')
  | regex_replace('(?m)^APP_API_URL=.*$', 'APP_API_URL=' ~ pub ~ '/api')
  | regex_replace('(?m)^APP_WEB_URL=.*$', 'APP_WEB_URL=' ~ app_web)
  | regex_replace('(?m)^FILES_URL=.*$', 'FILES_URL=' ~ pub)
  | regex_replace('(?m)^INTERNAL_FILES_URL=.*$', 'INTERNAL_FILES_URL=' ~ pub)
  | regex_replace('(?m)^TRIGGER_URL=.*$', 'TRIGGER_URL=' ~ pub)
  | regex_replace('(?m)^ENDPOINT_URL_TEMPLATE=.*$', 'ENDPOINT_URL_TEMPLATE=' ~ pub ~ '/e/{hook_id}')
%}
{% endif %}
{% if dify_openai_api_base is defined and dify_openai_api_base | length > 0 %}
{% set out = out | regex_replace('(?m)^OPENAI_API_BASE=.*$', 'OPENAI_API_BASE=' ~ dify_openai_api_base) %}
{% endif %}
{% if dify_next_public_socket_url is defined and dify_next_public_socket_url | length > 0 %}
{% set out = out | regex_replace('(?m)^NEXT_PUBLIC_SOCKET_URL=.*$', 'NEXT_PUBLIC_SOCKET_URL=' ~ dify_next_public_socket_url) %}
{% endif %}
{% if dify_nginx_server_name is defined and dify_nginx_server_name | length > 0 %}
{% set out = out | regex_replace('(?m)^NGINX_SERVER_NAME=.*$', 'NGINX_SERVER_NAME=' ~ dify_nginx_server_name) %}
{% endif %}
{% if dify_expose_nginx_port is defined %}
{% set out = out | regex_replace('(?m)^EXPOSE_NGINX_PORT=.*$', 'EXPOSE_NGINX_PORT=' ~ nginx_port) %}
{% endif %}
{% if dify_ssrf_allow_private_ips is defined and dify_ssrf_allow_private_ips | length > 0 %}
{% set out = out | regex_replace('(?m)^SSRF_PROXY_ALLOW_PRIVATE_IPS=.*$', 'SSRF_PROXY_ALLOW_PRIVATE_IPS=' ~ dify_ssrf_allow_private_ips) %}
{% endif %}
{% if dify_ssrf_allow_private_domains is defined and dify_ssrf_allow_private_domains | length > 0 %}
{% set out = out | regex_replace('(?m)^SSRF_PROXY_ALLOW_PRIVATE_DOMAINS=.*$', 'SSRF_PROXY_ALLOW_PRIVATE_DOMAINS=' ~ dify_ssrf_allow_private_domains) %}
{% endif %}
{{ out }}
