# Managed by Ansible — base Dify docker/.env
# Copy additional keys from dify/docker/.env.example as you adopt more features.

SECRET_KEY={{ vault_dify_secret_key }}

# Console / app URLs (must match reverse proxy or public DNS).
CONSOLE_API_URL={{ dify_console_url }}/console/api
CONSOLE_WEB_URL={{ dify_console_url }}
SERVICE_API_URL={{ dify_console_url }}/api
APP_API_URL={{ dify_console_url }}/api
APP_WEB_URL={{ dify_app_web_url }}

# Database (bundled Postgres service in default compose).
DB_USERNAME={{ dify_db_username | default('postgres') }}
DB_PASSWORD={{ vault_dify_db_password }}
DB_HOST={{ dify_db_host | default('db_postgres') }}
DB_PORT={{ dify_db_port | default('5432') }}
DB_DATABASE={{ dify_db_database | default('dify') }}

VECTOR_STORE={{ dify_vector_store | default('weaviate') }}

# ERP integration: set in app config / workflows using SERVICE_API_URL from ERP network.
