{# Managed by Ansible — full base from langfuse/.env or roles/langfuse/files/langfuse.env.j2.base #}
{% set hv = hostvars[inventory_hostname] %}
{% set ip = langfuse_node_ip | default(hv.ansible_host) %}
{% set registry = langfuse_registry_url | default(platform_registry_url | default(erp_registry_url | default('registry.sadgan.int'))) %}
{% set env_base = langfuse_env_base_path | default(role_path ~ '/files/langfuse.env.j2.base') %}
{% set raw = lookup('file', env_base) %}
{% set pg_pw = vault_langfuse_postgres_password | default('postgres') %}
{% set web_port = langfuse_web_host_port | default(3000) %}
{% set minio_port = langfuse_minio_api_port | default(9090) %}
{% set pub_url = platform_integration.langfuse_public_url | default('', true) %}
{% set nextauth = pub_url if pub_url | length > 0 else (langfuse_nextauth_url | default('http://' ~ ip ~ ':' ~ web_port)) %}
{% set web_ep = nextauth if pub_url | length > 0 else ('http://' ~ ip ~ ':' ~ web_port) %}
{% set minio_ep = 'http://' ~ ip ~ ':' ~ minio_port %}
{% set db_url = 'postgresql://postgres:' ~ pg_pw ~ '@postgres:5432/postgres' %}
{% set ch_tag = langfuse_clickhouse_image_tag | default('25.12.2') %}
{% set pg_tag = langfuse_postgres_image_tag | default(langfuse_postgres_version | default('18.0')) %}
{% set out = raw
  | regex_replace('(?m)^REGISTRY_URL=.*$', 'REGISTRY_URL=' ~ registry)
  | regex_replace('(?m)^LANGFUSE_CLICKHOUSE_IMAGE_TAG=.*$', 'LANGFUSE_CLICKHOUSE_IMAGE_TAG=' ~ ch_tag)
  | regex_replace('(?m)^LANGFUSE_POSTGRES_IMAGE_TAG=.*$', 'LANGFUSE_POSTGRES_IMAGE_TAG=' ~ pg_tag)
  | regex_replace('(?m)^LANGFUSE_COMPOSE_IMAGE_[A-Z_]+=.*\n?', '')
  | regex_replace('(?m)^SALT=.*$', 'SALT="' ~ vault_langfuse_salt ~ '"')
  | regex_replace('(?m)^ENCRYPTION_KEY=.*$', 'ENCRYPTION_KEY=' ~ vault_langfuse_encryption_key)
  | regex_replace('(?m)^NEXTAUTH_URL=.*$', 'NEXTAUTH_URL="' ~ nextauth ~ '"')
  | regex_replace('(?m)^DATABASE_URL=.*$', 'DATABASE_URL="' ~ db_url ~ '"')
  | regex_replace('(?m)^DIRECT_URL=.*$', 'DIRECT_URL="' ~ db_url ~ '"')
  | regex_replace('(?m)^LANGFUSE_AI_FEATURES_HOST=.*$', 'LANGFUSE_AI_FEATURES_HOST="' ~ web_ep ~ '"')
  | regex_replace('(?m)^LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=.*$', 'LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=' ~ minio_ep)
  | regex_replace('(?m)^LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=.*$', 'LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=' ~ minio_ep)
  | regex_replace('(?m)^LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=.*$', 'LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=' ~ minio_ep)
  | regex_replace('(?m)^LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=.*$', 'LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=' ~ minio_ep)
%}
{% if vault_langfuse_nextauth_secret is defined and vault_langfuse_nextauth_secret | length > 0 %}
{% set out = out | regex_replace('(?m)^NEXTAUTH_SECRET=.*$', 'NEXTAUTH_SECRET="' ~ vault_langfuse_nextauth_secret ~ '"') %}
{% endif %}
{% if vault_langfuse_redis_password is defined and vault_langfuse_redis_password | length > 0 %}
{% set out = out | regex_replace('(?m)^REDIS_AUTH=.*$', 'REDIS_AUTH="' ~ vault_langfuse_redis_password ~ '"') %}
{% endif %}
{% for stale_ip in langfuse_env_stale_node_ips | default(['192.168.10.209']) %}
{% set out = out | regex_replace(stale_ip | regex_escape, ip) %}
{% endfor %}
{% if langfuse_env_replace_loopback_host | default(true) | bool %}
{% set lb = langfuse_env_loopback_host | default('127.0.0.1') | regex_escape %}
{% set wp = web_port | string %}
{% set mp = minio_port | string %}
{% set out = out
  | regex_replace('http://' ~ lb ~ ':' ~ wp, 'http://' ~ ip ~ ':' ~ wp)
  | regex_replace('http://' ~ lb ~ ':' ~ mp, minio_ep)
  | regex_replace('"' ~ 'http://' ~ lb ~ ':' ~ wp ~ '"', '"' ~ web_ep ~ '"')
%}
{% endif %}
{% if 'LANGFUSE_CLICKHOUSE_IMAGE_TAG=' not in out %}
{{ out }}

# Image tags for compose.yaml ${REGISTRY_URL}/... (full refs: compose.override.images.yml)
LANGFUSE_CLICKHOUSE_IMAGE_TAG={{ ch_tag }}
LANGFUSE_POSTGRES_IMAGE_TAG={{ pg_tag }}
{% else %}
{{ out }}
{% endif %}
